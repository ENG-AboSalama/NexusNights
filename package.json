{
  "name": "discord-watch-together",
  "private": true,
  "version": "0.3.0",
  "description": "Netflix-style watch-together Discord Activity",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c red,yellow \"npm:dev:server\" \"npm:dev:client\"",
    "dev:tunnel": "concurrently -k -n api,web -c red,yellow \"npm:dev:server\" \"npm:dev:client:tunnel\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "dev:client:tunnel": "npm run dev:tunnel -w client",
    "build": "npm run build -w client && npm run build -w server",
    "start": "npm run start -w server",
    "scan": "npm run scan -w server",
    "list": "npm run list -w server",
    "test": "npm test -w server && npm test -w client",
    "sample-media": "npm run sample-media -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.5.0"
  }
}
