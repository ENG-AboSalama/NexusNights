# ── Discord OAuth2 (required for authentication) ───────────────
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
# Callback URL for OAuth2 - should match your domain
# Development: http://localhost:3001/api/auth/discord/callback
# Production: https://yourdomain.com/api/auth/discord/callback
DISCORD_REDIRECT_URI=http://localhost:3001/api/auth/discord/callback

# ── JWT Authentication ──────────────────────────────────────────
# Secret key for signing JWT tokens - CHANGE THIS IN PRODUCTION!
JWT_SECRET=change-me-in-production-use-long-random-string

# ── TMDB (https://www.themoviedb.org/settings/api) ──────────────
# Accepts either the v3 "API Key" or the v4 "API Read Access Token".
TMDB_API_KEY=your_tmdb_api_key_or_token

# ── Library ─────────────────────────────────────────────────────
# Folder that holds your videos. Relative paths are resolved from the repo root.
# Windows example: MEDIA_PATH=D:\Media
# Docker example: MEDIA_PATH=./media (mounted as volume)
MEDIA_PATH=./media

# ── Optional ────────────────────────────────────────────────────
PORT=3001
DATA_PATH=./data                 # index, TMDB cache, thumbnails, sprites, HLS output
TMDB_LANGUAGES=en-US,ar          # metadata is fetched once per language (UI is EN/AR)
TMDB_CACHE_DAYS=14
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_CONCURRENCY=2             # parallel ffmpeg jobs (thumbnails/sprites/transcodes)
SCAN_ON_START=true
ADMIN_TOKEN=                     # protects POST /api/library/rescan (random per-run if empty)
TRUST_PROXY=1                    # hops of reverse proxy / tunnel in front of the server

HLS_CONCURRENCY=2                # parallel ffmpeg->HLS jobs
HLS_CACHE_GB=20                  # LRU cap for prepared HLS streams

# ── Stage 3: watch-together ─────────────────────────────────────
# Browser testing without Discord: open http://localhost:5173/?room=test&name=Alice in two tabs.
# Default: on in development, OFF in production. Never enable it on a public production server.
ALLOW_GUEST=
# Optional: Discord role ids (comma separated) whose holders can ALWAYS control playback.
# Enabling this makes the Activity also ask for the "guilds.members.read" scope.
CONTROL_ROLE_IDS=

# ── Streaming Integration ───────────────────────────────────────
STREAMING_PROVIDERS_ENABLED=true

# ── Admin Dashboard ──────────────────────────────────────────────
# Discord User ID of the administrator (for Admin Dashboard access)
# Get your Discord ID: Right-click your profile → Copy ID (Developer Mode must be enabled)
ADMIN_DISCORD_ID=123456789012345678
