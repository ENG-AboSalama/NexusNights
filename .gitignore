# ── Dependencies ──────────────────────────────────────────────
node_modules/

# ── Build output ──────────────────────────────────────────────
dist/
build/
*.tsbuildinfo

# ── Secrets / environment ─────────────────────────────────────
.env
.env.*
!.env.example

# ── Runtime data (generated at run time) ──────────────────────
data/

# ── Your media library (never commit videos) ──────────────────
media/*
!media/.gitkeep
*.mkv
*.mp4
*.avi
*.mov
*.webm
*.m3u8
*.srt
*.vtt
*.ass

# ── Archives & binaries ───────────────────────────────────────
*.zip
*.rar
*.7z
cloudflared.exe
cloudflared

# ── Logs ──────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Test / coverage ───────────────────────────────────────────
coverage/
.nyc_output/

# ── Editors / OS ──────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini